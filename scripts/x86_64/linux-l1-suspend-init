#!/bin/sh
set -eu

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

private_var=
private_var_owned=0

cleanup() {
    if [ "$private_var_owned" = 1 ] && [ -n "$private_var" ]; then
        /bin/busybox rm -f "$private_var" || true
        private_var_owned=0
    fi
}

fail() {
    echo "thin-hv: linux S3 FAIL $1"
    cleanup
    /bin/busybox poweroff -f
    exit 1
}

verify_private_var() {
    [ -r "$private_var" ] || fail 'private EFI probe variable unavailable'
    [ "$(/bin/busybox dd if="$private_var" bs=1 skip=16 2>/dev/null)" = "$private_var_payload" ] \
        || fail 'private EFI probe payload changed'
    [ "$(/bin/busybox sha256sum "$private_var")" = "$private_var_hash" ] \
        || fail 'private EFI probe hash changed'
}

trap cleanup EXIT

state=$(/bin/busybox cat /sys/power/state)
mem_sleep=$(/bin/busybox cat /sys/power/mem_sleep)
echo "thin-hv: linux suspend states=$state"
echo "thin-hv: linux mem_sleep=$mem_sleep"

case " $state " in
    *' mem '*) ;;
    *) fail 'mem unavailable' ;;
esac
case "$mem_sleep" in
    *deep*) ;;
    *) fail 'deep unavailable' ;;
esac

modprobe kvm
modprobe kvm_intel nested=0
modprobe efivarfs
mount -t efivarfs efivarfs /sys/firmware/efi/efivars
firmware_var=$(/bin/busybox find /sys/firmware/efi/efivars -maxdepth 1 -type f \
    | /bin/busybox head -n 1)
[ -r "$firmware_var" ] || fail 'EFI variable unavailable'
firmware_var_hash=$(/bin/busybox sha256sum "$firmware_var")
echo "thin-hv: linux EFI runtime variable=$(/bin/busybox basename "$firmware_var")"
# Exercise the private Driver#### mapping without adding the slot to DriverOrder.
private_var_name=DriverFFFF
private_var="/sys/firmware/efi/efivars/$private_var_name-8be4df61-93ca-11d2-aa0d-00e098032b8c"
/bin/kvm-probe
echo deep >/sys/power/mem_sleep
for cycle in 1 2 3; do
    [ ! -e "$private_var" ] || fail 'private EFI probe variable already exists'
    private_var_payload="thin-hv-s3-profile-private-cycle-$cycle"
    private_var_owned=1
    # efivarfs attributes, then an inactive EFI_LOAD_OPTION with an end-only path.
    /bin/busybox printf \
        '\007\000\000\000\000\000\000\000\004\000\000\000\177\377\004\000%s' \
        "$private_var_payload" >"$private_var" \
        || fail 'private EFI probe write failed'
    private_var_hash=$(/bin/busybox sha256sum "$private_var") \
        || fail 'private EFI probe hash failed'
    verify_private_var
    echo "thin-hv: linux S3 private EFI write PASS cycle=$cycle variable=$private_var_name"
    echo "thin-hv: linux S3 suspend begin cycle=$cycle"
    /bin/busybox sync
    echo mem >/sys/power/state
    echo "thin-hv: linux S3 resume cycle=$cycle"
    /bin/kvm-probe
    /bin/busybox umount /sys/firmware/efi/efivars
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars
    [ "$(/bin/busybox sha256sum "$firmware_var")" = "$firmware_var_hash" ] \
        || fail 'EFI variable changed after resume'
    verify_private_var
    echo "thin-hv: linux S3 private EFI resume PASS cycle=$cycle variable=$private_var_name"
    /bin/busybox rm "$private_var" || fail 'private EFI probe delete failed'
    [ ! -e "$private_var" ] || fail 'private EFI probe remained after delete'
    private_var_owned=0
    echo "thin-hv: linux S3 private EFI delete PASS cycle=$cycle variable=$private_var_name"
    echo "thin-hv: linux S3 EFI runtime PASS cycle=$cycle"
done
echo 'thin-hv: linux S3 nested KVM PASS cycles=3'
/bin/busybox poweroff -f
